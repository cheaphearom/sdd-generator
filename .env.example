# Copy this file to .env and fill in your values. Never commit .env.

# How the SDD is written:
#   api          - Claude API, needs ANTHROPIC_API_KEY with API credit (default)
#   claude-code  - Claude Code CLI logged in with your Claude Pro/Max plan, no API key needed
SDD_PROVIDER=api

# Your Claude API key (needed when SDD_PROVIDER=api) from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional
# SDD_MODEL=claude-opus-5-5
# SDD_EFFORT=high
# PORT=4000
# SOFFICE_PATH=soffice
