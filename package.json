{
  "name": "sdd-generator",
  "version": "1.0.0",
  "description": "Upload a Business Requirements Document (BRD) and get a Software Design Document (SDD) back as Word and PDF",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "generate": "node src/cli.js",
    "sample": "node src/cli.js --from-json examples/sample-sdd.json --out examples/output"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "docx": "^9.15.1",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "mermaid": "^11.17.2",
    "multer": "^2.5.0",
    "pdf-parse": "^1.1.1"
  }
}
